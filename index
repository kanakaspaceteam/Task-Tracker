const cache=()=>{try{localStorage.setItem(KEY,JSON.stringify(orders))}catch(e){}};
function push(){
  if(!col)return;
  const cur=new Set();
  orders.forEach(o=>{cur.add(o.id);const g=sig(o);if(synced[o.id]!==g){synced[o.id]=g;col.doc(o.id).set(JSON.parse(JSON.stringify(o))).catch(err=>{delete synced[o.id];$("sync").textContent="Gagal menyimpan ke cloud";toast("Gagal simpan ke cloud: "+(err.code||err.message))})}});
  Object.keys(synced).forEach(id=>{if(!cur.has(id)){delete synced[id];col.doc(id).delete().catch(()=>{})}});
}
const save=()=>{cache();if(col)push();else{const p=getPend();orders.forEach(o=>p.add(o.id));setPend(p)}};
const openAuth=()=>{$("auth").classList.add("open");setTimeout(()=>$("aEmail").focus(),50)};
const closeAuth=()=>$("auth").classList.remove("open");
const AERR={"auth/invalid-credential":"Email atau password salah","auth/wrong-password":"Email atau password salah","auth/user-not-found":"Akun belum dibuat di Firebase Console","auth/invalid-email":"Format email tidak valid","auth/network-request-failed":"Tidak ada koneksi internet","auth/operation-not-allowed":"Aktifkan Email/Password di Firebase Console","auth/too-many-requests":"Terlalu banyak percobaan, coba lagi nanti"};
function doAuth(){
  const e=$("aEmail").value.trim(),p=$("aPass").value;$("aErr").textContent="";
  if(!auth){$("aErr").textContent="Firebase tidak terhubung";return}
  if(!e||!p){$("aErr").textContent="Isi email dan password";return}
  $("aIn").disabled=true;
  auth.signInWithEmailAndPassword(e,p)
    .catch(err=>{$("aErr").textContent=AERR[err.code]||err.message})
    .finally(()=>{$("aIn").disabled=false});
}
$("aIn").onclick=doAuth;
$("aX").onclick=closeAuth;
$("auth").addEventListener("click",e=>{if(e.target===$("auth"))closeAuth()});
$("aShow").onchange=e=>{$("aPass").type=e.target.checked?"text":"password"};
$("aPass").addEventListener("keydown",e=>{if(e.key==="Enter")doAuth()});
$("outBtn").onclick=()=>{if(!auth){toast("Firebase tidak terhubung");return}user?auth.signOut():openAuth()};
if(!auth){$("sync").textContent="Mode lokal (Firebase tidak terhubung)";$("outBtn").style.display="none"}
else auth.onAuthStateChanged(u=>{
  user=u;
  if(unsub){unsub();unsub=null}
  if(!u){
    col=null;synced={};const p=getPend();orders=orders.filter(o=>p.has(o.id));cache();render();
    $("outBtn").textContent="Masuk";$("sync").textContent="Belum tersinkron";
    if(!asked){asked=true;openAuth()}
    return;
  }
  closeAuth();$("aPass").value="";$("outBtn").textContent="Keluar";$("sync").textContent="Menyinkronkan…";
  col=db.collection("users").doc(u.uid).collection("orders");
  let first=true;
  unsub=col.onSnapshot(snap=>{
    const cloud=snap.docs.map(d=>d.data());
    synced={};snap.docs.forEach(d=>{synced[d.id]=sig(d.data())});
    if(first){
      first=false;
      const ids=new Set(cloud.map(o=>o.id)),p=getPend(),mk="kanaka-migrated-"+u.uid;let done=null;try{done=localStorage.getItem(mk)}catch(e){}
      orders.forEach(o=>{if(!ids.has(o.id)&&(p.has(o.id)||!done))cloud.push(o)});
      setPend(new Set());try{localStorage.setItem(mk,"1")}catch(e){}
    }
    orders=cloud;cache();render();push();
    $("sync").textContent=(snap.metadata.fromCache?"Offline, tersimpan di device":"Tersinkron")+" · "+u.email;
  },err=>{$("sync").textContent="Gagal sinkron: "+(err.code||"");toast("Gagal sinkron: "+(err.code||err.message))});
});

const rp=n=>(n<0?"-":"")+"Rp"+Math.abs(n||0).toLocaleString("id-ID");
const esc=s=>String(s||"").replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]));
const iso=d=>new Date(d.getTime()-d.getTimezoneOffset()*6e4).toISOString().slice(0,10);
const today=()=>iso(new Date());
const addDays=(s,n)=>{const d=new Date(s+"T00:00:00");d.setDate(d.getDate()+n);return iso(d)};
const diff=(a,b)=>Math.round((new Date(a+"T00:00:00")-new Date(b+"T00:00:00"))/DAY);
const fmtD=s=>new Date(s+"T00:00:00").toLocaleDateString("id-ID",{day:"numeric",month:"short"});
const fmtL=s=>new Date(s+"T00:00:00").toLocaleDateString("id-ID",{day:"numeric",month:"long",year:"numeric"});
const prune=()=>{const n=orders.length;orders=orders.filter(o=>!(o.sentAt&&Date.now()-o.sentAt>30*DAY));if(orders.length!==n)save()};

let priceManual=false,dlManual=false,lastOther=false;
const curSvc=()=>SERVICES[$("fSvc").value];
$("fSvc").innerHTML=SERVICES.map((s,i)=>`<option value="${i}">${s.name}</option>`).join("");
function fillPkg(){
  const s=curSvc();
  $("wOtherPrice").hidden=!s.other;
  if(s.other!==lastOther){lastOther=s.other;$("fPhone").value=""}
  $("lPhone").textContent=s.other?"Judul Orderan":"4 angka terakhir nomor HP klien";
  $("fPhone").placeholder=s.other?"Judul orderan":"Tambahkan 4 angka terakhir";
  $("fPhone").inputMode=s.other?"text":"numeric";
  if(s.other)$("fPhone").removeAttribute("maxlength");else $("fPhone").maxLength=4;
  $("wPkg").hidden=$("wPrice").hidden=!!s.other;
  if(!s.other)$("fPkg").innerHTML=s.opts.map((o,i)=>`<option value="${i}">${o[0]} – ${rp(o[1])}</option>`).join("");
  $("fUps").innerHTML=s.ups.map((u,i)=>`<label class="chk"><input type="checkbox" data-i="${i}">${u[0]} +${rp(u[1])}</label>`).join("");
  $("fUps").querySelectorAll("input").forEach(c=>c.addEventListener("change",()=>{
    if(c.checked&&s.ups[c.dataset.i][2]==="tarot")$("fUps").querySelectorAll("input").forEach(x=>{if(x!==c&&s.ups[x.dataset.i][2]==="tarot")x.checked=false});
    recalc();
  }));
  recalc(true);
}
function calc(){
  const s=curSvc(),base=s.other?(+$("fOtherPrice").value||0):s.opts[$("fPkg").value||0][1];
  let sum=base,quick=false;
  $("fUps").querySelectorAll("input:checked").forEach(c=>{const u=s.ups[c.dataset.i];sum+=u[1];if(u[2]==="quick")quick=true});
  return{s,base,sum,quick};
}
function recalc(force){
  const {s,sum,quick}=calc();
  if(force===true)priceManual=false;
  if(!priceManual)$("fPrice").value=sum;
  if(!dlManual||force===true){if(force===true)dlManual=false;$("fDl").value=addDays($("fOd").value||today(),quick?1:s.dl)}
  $("fTot").textContent=s.other&&$("fTbd").checked?"Harga menyusul":rp(s.other?sum:(+$("fPrice").value||0));
}
$("fSvc").addEventListener("change",fillPkg);
$("fPkg").addEventListener("change",()=>recalc(true));
$("fOd").addEventListener("change",()=>{dlManual=false;recalc()});
$("fDl").addEventListener("change",()=>{dlManual=true});
$("fPrice").addEventListener("input",()=>{priceManual=true;recalc()});
$("fOtherPrice").addEventListener("input",e=>{e.target.value=e.target.value.replace(/\D/g,"");recalc()});
$("fPhone").addEventListener("input",e=>{if(!curSvc().other)e.target.value=e.target.value.replace(/\D/g,"").slice(0,4)});
$("fTbd").addEventListener("change",()=>{$("fOtherPrice").disabled=$("fTbd").checked;if($("fTbd").checked)$("fOtherPrice").value="";recalc()});
function openForm(){
  $("formBox").classList.add("open");document.body.classList.add("fo");
  ["fPhone","fNote","fOtherPrice"].forEach(i=>$(i).value="");
  $("fTbd").checked=false;$("fOtherPrice").disabled=false;
  $("fOd").value=today();priceManual=false;dlManual=false;fillPkg();
  $("fPhone").focus();$("formBox").scrollIntoView({behavior:"smooth",block:"center"});
}
const closeForm=()=>{$("formBox").classList.remove("open");document.body.classList.remove("fo")};
$("addBtn").onclick=$("fabBtn").onclick=()=>$("formBox").classList.contains("open")?closeForm():openForm();
$("cancelBtn").onclick=closeForm;

function bad(id){$(id).focus();$(id).style.borderColor="var(--late)";setTimeout(()=>$(id).style.borderColor="",1800)}
function doSave(){
  const ph=$("fPhone").value.trim();
  if(curSvc().other?!ph:ph.length!==4)return bad("fPhone");
  const {s,base,sum}=calc();
  
  const tbd=!!(s.other&&$("fTbd").checked);
  const odate=$("fOd").value||today();
  const ups=[...$("fUps").querySelectorAll("input:checked")].map(c=>({n:s.ups[c.dataset.i][0],p:s.ups[c.dataset.i][1]}));
  const price=tbd?0:(s.other?sum:(+$("fPrice").value||0));
  const code=s.other?ph.replace(/[^A-Za-z0-9]/g,"").slice(0,4).toUpperCase():ph;
  if(!code)return bad("fPhone");
  const pre=odate.slice(2,4)+odate.slice(5,7)+odate.slice(8,10)+code;
  let seq=0;orders.forEach(o=>{if(o.id.startsWith(pre)){const n=parseInt(o.id.slice(pre.length));if(n>seq)seq=n}});
  const o={id:pre+(seq+1),ph:s.other?"":ph,title:s.other?ph:"",svc:s.other?ph:s.name,pkg:s.other?"Custom":s.opts[$("fPkg").value][0],base,ups,price,tbd,odate,dl:$("fDl").value||today(),stage:0,sentAt:null,note:$("fNote").value.trim()};
  orders.push(o);save();closeForm();render();showReceipt(o.id);
}
$("saveBtn").onclick=()=>{try{doSave()}catch(e){toast("Error: "+e.message)}};

$("filters").addEventListener("click",e=>{const b=e.target.closest(".fl");if(!b)return;filter=b.dataset.f;document.querySelectorAll(".fl").forEach(x=>x.classList.toggle("on",x===b));render()});
$("list").addEventListener("click",e=>{
  const row=e.target.closest(".order");if(!row)return;
  const o=orders.find(x=>x.id===row.dataset.id);if(!o)return;
  const t=e.target;
  if(t.classList.contains("st")){o.stage=+t.dataset.s;o.sentAt=o.stage===2?Date.now():null;save();render()}
  else if(t.classList.contains("rcb"))showReceipt(o.id);
  else if(t.classList.contains("del")){
    if(t.classList.contains("sure")){orders=orders.filter(x=>x!==o);save();render()}
    else{t.classList.add("sure");t.textContent="Yakin hapus?";setTimeout(()=>{t.classList.remove("sure");t.textContent="Hapus"},2500)}
  }
});

function showReceipt(id){
  const o=orders.find(x=>x.id===id);if(!o)return;
  const rows=[`<div class="rrow"><span>${o.pkg==="Custom"?"Biaya layanan":esc(o.pkg)}</span><b>${o.tbd?"Menyusul":rp(o.base)}</b></div>`];
  o.ups.forEach(u=>rows.push(`<div class="rrow"><span>${esc(u.n)}</span><b>${rp(u.p)}</b></div>`));
  const sum=o.base+o.ups.reduce((a,u)=>a+u.p,0);
  if(!o.tbd&&o.price!==sum)rows.push(`<div class="rrow"><span>Penyesuaian</span><b>${rp(o.price-sum)}</b></div>`);
  $("ovIn").innerHTML=`<button class="xbtn" id="ovX" aria-label="Tutup">✕</button><div class="rcard"><div class="rhead"><img class="rlogo" src="${LOGO_URL}" crossorigin="anonymous" alt="" onerror="this.onerror=null;if(logo)this.src=logo;else this.remove()"><h2>Kanaka Space</h2><p>Konfirmasi Pesanan &amp; Harga</p></div><div class="rbody">
  <div class="rid"><small>ORDER ID</small><b>${o.id}</b></div>
  ${statusHtml(o.stage)}
  <div class="rrow"><span>Tanggal order</span><b>${fmtL(o.odate)}</b></div>
  ${o.title?`<div class="rrow"><span>Judul orderan</span><b>${esc(o.title)}</b></div>`:`<div class="rrow"><span>No. HP</span><b>••••${o.ph}</b></div>`}
  <div class="rrow"><span>Layanan</span><b>${esc(o.pkg==="Custom"?"Other":o.svc)}</b></div>
  ${rows.join("")}
  <div class="rrow"><span>Estimasi hasil</span><b>${fmtL(o.dl)}</b></div>
  ${o.note?`<div class="rrow"><span>Catatan</span><b>${esc(o.note)}</b></div>`:""}
  <div class="rtot"><span>Total</span><b>${o.tbd?"Menyusul":rp(o.price)}</b></div>
  <p class="rfoot">Mohon cek kembali detail pesanan sebelum melakukan pembayaran.<br><b>@kanakaspace | +62878 2658 4334 | kanakaspace@gmail.com</b></p></div></div>
  <div class="ov-actions">Simpan gambar kartu di atas untuk dikirim ke klien<br><button class="btn" id="ovSave">${SAVE_LABEL}</button></div>`;
  $("ov").classList.add("open");$("ov").scrollTop=0;document.body.style.overflow="hidden";
  $("ovX").onclick=closeOv;
  $("ovSave").onclick=()=>saveImg(o);
}
const STG=[{n:"Pembayaran",m:"Menunggu pembayaran",c:"#f6d143",r:"rgba(246,209,67,.38)",bg:"#fff4cf",tx:"#6b5300"},{n:"Diproses",m:"Pesanan sedang diproses",c:"#fcb45f",r:"rgba(252,180,95,.38)",bg:"#ffe9d0",tx:"#7a4410"},{n:"Terkirim",m:"Pesanan sudah terkirim",c:"#ff8078",r:"rgba(255,128,120,.35)",bg:"#ffe1dd",tx:"#8a2f29"}];
function statusHtml(s){const cur=STG[s];return `<div class="rstat" style="background:${cur.bg};color:${cur.tx}"><div class="rpill">${cur.m}</div><div class="rsteps">${STG.map((g,i)=>`<div class="rs ${i<=s?"on":""} ${i===s?"cur":""}" style="--c:${g.c};--r:${g.r}"><i>${i<s||(s===2&&i===2)?"✓":i+1}</i>${g.n}</div>`).join("")}</div></div>`}
function setLogo(f,id){if(!f)return;const r=new FileReader();r.onload=()=>{const im=new Image();im.onload=()=>{const s=Math.min(1,320/Math.max(im.width,im.height)),cv=document.createElement("canvas");cv.width=Math.round(im.width*s);cv.height=Math.round(im.height*s);cv.getContext("2d").drawImage(im,0,0,cv.width,cv.height);logo=cv.toDataURL("image/png");try{localStorage.setItem(LOGO_KEY,logo)}catch(e){}showReceipt(id)};im.src=r.result};r.readAsDataURL(f)}
function closeOv(){$("ov").classList.remove("open");document.body.style.overflow=""}
function showImg(u){const c=document.querySelector("#ovIn .rcard");if(c)c.outerHTML=`<img src="${u}" alt="Konfirmasi pesanan" style="display:block;width:100%;max-width:380px;margin:0 auto;border-radius:24px"><p style="max-width:380px;margin:10px auto 0;text-align:center;color:#fff;font-size:12.5px">Tahan lama gambar, lalu pilih Simpan ke Foto.</p>`}
async function saveImg(o){
  const b=$("ovSave"),card=document.querySelector("#ovIn .rcard");
  if(!card)return;
  b.disabled=true;b.textContent="Memproses...";
  try{
    const cv=await html2canvas(card,{scale:3,backgroundColor:null,useCORS:true});
    const blob=await new Promise(r=>cv.toBlob(r,"image/png"));
    const name="Kanaka Space "+o.id+".png";
    if(MOBILE&&window.File&&navigator.canShare&&navigator.share){
      try{const f=new File([blob],name,{type:"image/png"});if(navigator.canShare({files:[f]})){await navigator.share({files:[f]});b.textContent=SAVE_LABEL;b.disabled=false;return}}
      catch(e){if(e&&e.name==="AbortError"){b.textContent=SAVE_LABEL;b.disabled=false;return}}
    }
    let dl=null;try{dl=window.claude&&await window.claude.use("downloads")}catch(e){}
    if(dl){
      try{await dl.save({filename:name,data:blob})}
      catch(err){if(!(err&&err.code==="declined"))showImg(cv.toDataURL("image/png"))}
    }else{
      if(MOBILE)showImg(cv.toDataURL("image/png"));
      else{const a=document.createElement("a");a.href=URL.createObjectURL(blob);a.download=name;document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),4000)}
    }
    b.textContent=SAVE_LABEL;
  }catch(e){b.textContent="Gagal, coba screenshot";setTimeout(()=>{b.textContent=SAVE_LABEL},2500)}
  b.disabled=false;
}
$("ov").addEventListener("click",e=>{if(e.target===$("ov"))closeOv()});
document.addEventListener("keydown",e=>{if(e.key==="Escape")closeOv()});

function render(){
  prune();
  const t=today(),total=orders.length,c=[0,1,2].map(i=>orders.filter(o=>o.stage===i).length);
  const pct=total?Math.round(c[2]/total*100):0;
  $("bigNum").innerHTML=`${c[2]}<small>/${total} terkirim</small>`;
  $("barFill").style.width=pct+"%";
  $("msg").textContent=!total?"Belum ada order. Tambah yang pertama!":pct===100?"Semua terkirim! Waktunya istirahat :)":pct>=70?"Udah banyak yang terkirim, dikit lagi!":pct>=40?"Lumayan, lanjut terus ya":"Masih banyak yang belum selesai";
  c.forEach((n,i)=>$("s"+i).textContent=n);
  $("sTelat").textContent=orders.filter(o=>o.stage<2&&diff(o.dl,t)<0).length;
  let rows=orders.filter(o=>filter==="all"||o.stage===+filter);
  rows.sort((a,b)=>(a.stage===2)-(b.stage===2)||(a.stage===2?b.sentAt-a.sentAt:a.dl.localeCompare(b.dl)));
  if(!rows.length){$("list").innerHTML=`<div class="empty">${total?"Tidak ada order di filter ini.":"Klik “+ Order Baru” buat mulai."}</div>`;return}
  const L=["Pembayaran","Diproses","Terkirim"];
  $("list").innerHTML=rows.map(o=>{
    const d=diff(o.dl,t),fin=o.stage===2;
    const k=fin?"done":d<0?"late":d===0?"today":"";
    const lbl=fin?`Terkirim · hapus ${Math.max(1,Math.ceil(30-(Date.now()-o.sentAt)/DAY))} hari lagi`:d<0?`Telat ${-d} hari · ${fmtD(o.dl)}`:d===0?"Deadline hari ini":d===1?`Besok · ${fmtD(o.dl)}`:`${d} hari lagi · ${fmtD(o.dl)}`;
    return `<div class="order ${k} s${o.stage}" data-id="${o.id}"><div class="ob">
      <div class="oid">#${o.id}${o.title?"":`<span>HP ••••${o.ph}</span>`}</div>
      <div class="nm">${esc(o.svc)}</div>
      <div class="sv">${esc(o.pkg)}${o.ups.length?" + "+esc(o.ups.map(u=>u.n).join(", ")):""}</div>
      <div class="chips"><span class="chip ${fin?"":k}">${lbl}</span><span class="chip">Order ${fmtD(o.odate)}</span><span class="chip">${o.tbd?"Harga menyusul":rp(o.price)}</span></div>
      <div class="steps">${L.map((n,i)=>`<button class="st ${i<o.stage?"past":""} ${i===o.stage?"cur":""} ${i===o.stage&&i===2?"last":""}" data-s="${i}">${i<o.stage?"✓ ":""}${n}</button>`).join("")}</div>
      ${o.note?`<div class="note">${esc(o.note)}</div>`:""}</div>
      <div class="right"><button class="rcb">Rincian</button><button class="del">Hapus</button></div></div>`;
  }).join("");
}
render();
</script>
</body>
