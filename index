  <div class="card" id="formBox">
    <div class="grid">
      <div><label class="f" for="fPhone" id="lPhone">4 angka terakhir nomor HP klien</label><input type="text" id="fPhone" inputmode="numeric" maxlength="4" placeholder="Tambahkan 4 angka terakhir" autocomplete="off"></div>
